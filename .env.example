# String de conexão do MongoDB (Ex: mongodb+srv://usuario:senha@cluster.mongodb.net/)
MONGODB_URI=
MONGODB_DB_NAME=catheceseflow_ai

# Configuração da OpenAI / LLM (LangChain)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Porta do servidor FastAPI
PORT=8000

# PostgreSQL (opcional se já configurado no Backend/.env local; use em produção/Vercel/Render)
POSTGRES_URI=
